# Configuraciones de Entorno para MagnusAgent

# Adaptador de proveedor de IA principal (anthropic | ollama)
MAGNUS_PROVIDER=anthropic

# Credenciales de proveedores remotos (opcional si usas Ollama local)
ANTHROPIC_API_KEY=tu_clave_de_api_anthropic_aqui

# Token de seguridad para servidor HTTP MCP (si se despliega fuera de localhost)
MAGNUS_HTTP_TOKEN=tu_token_secreto_aleatorio_aqui

# Directorio opcional para almacenamiento de trazas de auditoría
MAGNUS_TRACE_DIR=./traces
